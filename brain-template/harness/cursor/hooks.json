{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node \"{{BRAIN}}/harness/cursor/context-boot.mjs\"", "timeout": 10 }
    ],
    "beforeShellExecution": [
      { "command": "node \"{{BRAIN}}/harness/cursor/prod-guard.mjs\"", "timeout": 10, "failClosed": true },
      { "command": "node \"{{BRAIN}}/.claude/hooks/vendor-guard.mjs\"", "timeout": 10 }
    ],
    "beforeReadFile": [
      { "command": "node \"{{BRAIN}}/harness/cursor/prod-guard.mjs\"", "timeout": 10, "failClosed": true }
    ],
    "stop": [
      { "command": "node \"{{BRAIN}}/harness/cursor/correction-log.mjs\"", "timeout": 10 }
    ]
  }
}
