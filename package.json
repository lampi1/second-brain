{
  "name": "second-brain-app",
  "productName": "second-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop cockpit for AI coding agents: run Claude Code and Cursor chats side by side, answer their questions in one place, watch the browsers they drive over MCP and see your second brain update live.",
  "keywords": [
    "claude-code",
    "cursor",
    "ai-agents",
    "multi-agent",
    "electron",
    "mcp",
    "desktop-app",
    "second-brain",
    "developer-tools"
  ],
  "homepage": "https://github.com/lampi1/second-brain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lampi1/second-brain.git"
  },
  "bugs": {
    "url": "https://github.com/lampi1/second-brain/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "genui:preview": "node scripts/genui-preview.mjs",
    "genui:test": "vitest run test/unit/genui.test.ts test/unit/genui-render.test.ts test/unit/keys.test.ts",
    "genui:lint": "eslint src/renderer/components/GenUi.tsx src/renderer/components/RequestPanel.tsx src/renderer/components/genui src/renderer/genui-preview.tsx src/renderer/i18n/it.ts src/renderer/i18n/en.ts src/renderer/i18n/areas/genui-request.it.ts src/renderer/i18n/areas/genui-request.en.ts scripts/genui-preview.mjs test/unit/genui-render.test.ts test/e2e/genui.spec.ts test/e2e/genui-choices.spec.ts",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "electron .",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "shots": "node scripts/build.mjs && playwright test --config playwright.shots.config.ts",
    "check": "node scripts/check.mjs",
    "check:branch": "node scripts/check-branch.mjs",
    "doctor": "node scripts/doctor.mjs",
    "logs": "node scripts/logs.mjs",
    "setup": "npm ci && node node_modules/electron/install.js && node scripts/setup-hooks.mjs",
    "promote": "node scripts/release.mjs promote",
    "rollback": "node scripts/release.mjs rollback",
    "release": "node scripts/release.mjs status",
    "test:stable": "playwright test --config playwright.stable.config.ts",
    "package:windows": "node scripts/package-windows.mjs",
    "test:installer": "playwright test --config playwright.installer.config.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "3d-force-graph": "1.79.1",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sqlite-vec": "0.1.9",
    "three": "0.186.1",
    "three-spritetext": "1.9.6"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.283",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.283",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.283",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.283",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.283",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.283"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "license": "MIT"
}
