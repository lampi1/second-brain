{
  "name": "second-brain-app",
  "productName": "second-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop cockpit for Claude Code and Cursor: chats as tiles, questions as panels, internal browsers over MCP, a live brain.",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "doctor": "node scripts/doctor.mjs",
    "logs": "node scripts/logs.mjs",
    "setup": "npm ci && node node_modules/electron/install.js",
    "promote": "node scripts/release.mjs promote",
    "rollback": "node scripts/release.mjs rollback",
    "release": "node scripts/release.mjs status"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.283",
    "3d-force-graph": "1.79.1",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-spritetext": "1.9.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
